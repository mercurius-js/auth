{
  "name": "mercurius-auth",
  "version": "6.0.0",
  "description": "Mercurius Auth Plugin adds configurable Authentication and Authorization support to Mercurius.",
  "main": "index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "unit": "borp --no-typescript --timeout 300000 --reporter spec 'test/**/*.js'",
    "cov": "borp --coverage --no-typescript --check-coverage --lines 100 --functions 100 --statements 100 --branches 100 --timeout 300000 --reporter spec 'test/**/*.js'",
    "lint": "npm run lint:standard && npm run lint:typescript",
    "lint:standard": "standard | snazzy",
    "lint:typescript": "standard --parser @typescript-eslint/parser --plugin @typescript-eslint/eslint-plugin types/**/*.ts | snazzy",
    "typescript": "tstyche",
    "test": "npm run lint && npm run unit && npm run typescript"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mercurius-js/auth.git"
  },
  "author": "Jonny Green <hello@jonnydgreen.com>",
  "contributors": [
    {
      "name": "Matteo Collina",
      "email": "hello@matteocollina.com"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mercurius-js/auth/issues"
  },
  "homepage": "https://github.com/mercurius-js/auth",
  "devDependencies": {
    "@fastify/pre-commit": "^2.2.1",
    "@mercuriusjs/federation": "^4.0.0",
    "@mercuriusjs/gateway": "^4.0.0",
    "@sinonjs/fake-timers": "^10.0.2",
    "@types/node": "^20.1.0",
    "@types/ws": "^8.5.3",
    "@typescript-eslint/eslint-plugin": "^5.30.5",
    "@typescript-eslint/parser": "^5.30.5",
    "autocannon": "^7.9.0",
    "borp": "^0.21.0",
    "concurrently": "^8.0.1",
    "fastify": "^5.0.0",
    "mercurius": "^15.0.0",
    "snazzy": "^9.0.0",
    "standard": "^17.0.0",
    "tstyche": "^7.1.0",
    "typescript": "^6.0.3",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "@fastify/error": "^4.0.0",
    "fastify-plugin": "^5.0.0",
    "graphql": "^16.2.0"
  },
  "pre-commit": [
    "lint"
  ]
}
